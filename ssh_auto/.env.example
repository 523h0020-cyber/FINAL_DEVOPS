# DigitalOcean API Token (bắt buộc — tạo tại https://cloud.digitalocean.com/account/api/tokens)
DO_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cấu hình nhánh Git dành cho các thành viên trong nhóm
GIT_BRANCH=main

# --- CẤU HÌNH GITHUB ACTIONS CI/CD (Tùy chọn tự động setup secrets) ---
# Tự động đăng nhập GitHub bằng Token cá nhân (tạo tại Developer settings > Personal access tokens)
GITHUB_TOKEN=ghp_xxxxxxxxx

# Thông tin Docker Hub để script tự động chèn vào Github Actions Secrets
DOCKERHUB_USERNAME=your_dockerhub_account
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxx

# Domain trỏ về Reserved IP của DigitalOcean manager
DOMAIN_NAME=523h0020.site

# Grafana admin (bắt buộc nhập khi chạy script lần đầu)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeMe_123!

# Tự động điền bởi script — không cần sửa tay
CONFIG_VERSION=
SSH_KEY_PATH=
MANAGER_IP=
WORKER_IP_PRIMARY=
WORKER_IPS=
