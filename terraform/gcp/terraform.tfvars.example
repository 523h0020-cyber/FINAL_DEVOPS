project_name            = "final-tier4"
project_id              = "your-gcp-project-id"
region                  = "asia-southeast1"
zone                    = "asia-southeast1-a"
deployment_mode         = "swarm" # swarm or kubernetes
vpc_name                = "final-tier4-vpc"
public_subnet_cidr      = "10.20.1.0/24"
private_subnet_cidr     = "10.20.10.0/24"
pods_secondary_range    = "10.20.20.0/20"
services_secondary_range = "10.20.40.0/24"

# Used in swarm mode
machine_type = "e2-medium"

# Used in kubernetes mode
gke_node_count        = 2
gke_node_machine_type = "e2-standard-2"
